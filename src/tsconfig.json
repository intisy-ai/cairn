{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../out/tsc",
    "rootDir": ".",
    "composite": true
  },
  "include": ["main/**/*.ts", "preload/**/*.ts", "sidecar/**/*.ts", "installer/**/*.ts"],
  "exclude": ["main/**/*.test.ts", "preload/**/*.test.ts", "sidecar/**/*.test.ts", "installer/**/*.test.ts"],
  "references": [{ "path": "../packages/shared" }, { "path": "../vendor" }]
}
