{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    // An alias exists only for a sibling repo Cairn imports CODE from. custom-auth has none
    // on purpose: Cairn reads that plugin's config, located by capability, never its code.
    "paths": {
      "@core/*": ["./core/dist/*"],
      "@core-auth/*": ["./core-auth/dist/*"],
      "@core-loader/*": ["./core-loader/dist/*"],
      "@core-proxy/*": ["./core-proxy/dist/*"],
      "@plugin-updater/*": ["../../tools/plugin-updater/dist/*"],
      "@config-ledger/*": ["../../plugins/config-ledger/dist/*"]
    }
  }
}
